{
  "author": "zbryikt",
  "name": "schulze.js",
  "license": "MIT",
  "description": "Schulze method JavaScript implementation.",
  "version": "0.2.2",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "homepage": "https://github.com/zbryikt/schulze.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zbryikt/schulze.js"
  },
  "engines": {
    "node": ">=10.14.1",
    "npm": ">=6.4.1"
  },
  "scripts": {
    "start": "npx server -r web -o true",
    "deploy": "npx deploy web/static",
    "test": "npx mocha --require livescript ./test/index.ls",
    "coverage": "npx nyc --reporter=text npm run test"
  },
  "nyc": {
    "all": true,
    "extension": ".ls",
    "require": [
      "livescript"
    ],
    "include": [
      "src/**/*"
    ]
  },
  "devDependencies": {
    "@loadingio/bootstrap.ext": "^0.0.12",
    "@loadingio/ldquery": "^3.0.6",
    "@plotdb/guides": "github:plotdb/guides#master",
    "@plotdb/sheet": "^0.7.4",
    "@zbryikt/deploy": "^0.0.4",
    "@zbryikt/template": "^2.4.3",
    "bootstrap": "^4.6.1",
    "bootstrap.native": "^3.0.14",
    "fedep": "1.7.6",
    "ldcover": "^3.6.0",
    "ldiconfont": "^0.3.0",
    "ldview": "^1.7.2",
    "livescript": "^1.6.0",
    "mocha": "^11.8.0",
    "mochawesome": "^7.1.3",
    "nyc": "^15.1.0",
    "uglify-js": "^3.13.1",
    "yargs": "^16.1.0"
  },
  "dependencies": {
    "papaparse": "^5.3.0"
  },
  "frontendDependencies": {
    "root": "web/static/assets/lib",
    "modules": [
      "papaparse",
      "@plotdb/sheet",
      "bootstrap",
      "bootstrap.native",
      "@loadingio/bootstrap.ext",
      "@loadingio/ldquery",
      "ldview",
      "ldcover",
      "ldiconfont"
    ]
  }
}
