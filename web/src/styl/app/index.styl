// swipe back gets sticky once triggered anywhere, so contain it on body.
// https://github.com/plotdb/sheet#swipe-back-issue
body
  overscroll-behavior: contain
  font-family: arial

// direct child only - sheet builds its own `.inner` underneath, and sizing that one
// instead collapses every row.
#grid > .inner
  height: 360px

#detail-grid > .inner
  height: 700px

.sheet
  border: 1px solid #ddd
  border-radius: 3px
  text-align: center

  // frozen row / col are exactly the header row and the label column here
  .cell.frozen
    background: #f6f7f8
    color: #555
  .cell.name
    text-align: left
    padding-left: .5em
  .cell.rank
    background: #f6f7f8
    font-weight: 500
  .cell.win
    background: #9f9
  .cell.lose
    background: #f99
  .cell.tie
    background: #eee

#detail-grid .cell
  cursor: pointer

.sheet .cell.picked
  box-shadow: inset 0 1px 0 #27f, inset 0 -1px 0 #27f

#explain
  &:empty
    display: none
  text-align: left
  border: 1px solid #ddd
  border-radius: 3px
  padding: 1em 1.25em

  .ex-head
    font-size: 1.15em
    margin-bottom: .25em
  .ex-rank
    color: #888
    font-size: .8em
    font-weight: normal
  .ex-sub
    color: #666
    font-size: .85em
    margin: 0 0 .75em

  .ex-block
    border-left: 3px solid #ddd
    padding: .4em 0 .4em .75em
    margin-bottom: .75em
  .ex-block-head
    display: flex
    align-items: baseline
    gap: .5em
  // walk up the chain: who blocked the blocker?
  .ex-link
    cursor: pointer
    border-bottom: 1px dashed #aaa
    &:hover
      color: #27f
      border-bottom-color: #27f
  .ex-strength
    margin-left: auto
    font-size: .85em
    color: #888
  .ex-note
    color: #b35
    font-size: .85em
    margin: .15em 0 .4em

  // one strongest path: nodes joined by the head to head result of each hop
  .chain
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: .35em
    .node
      background: #eef1f4
      border-radius: 3px
      padding: .15em .5em
      max-width: 16em
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
    .link
      color: #888
      font-size: .8em
      // read as `a --31:14-> b`
      &:before
        content: "\2014"
        color: #ccc
      &:after
        content: "\2192"
        color: #ccc
    .link.weakest
      color: #27f
      font-weight: 500
