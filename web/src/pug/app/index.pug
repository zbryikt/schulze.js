extends /base.pug
block prehead
  base(href="..")
block head
  +css({name: "@plotdb/sheet"})
  +css("/css/app/index.css")
block body
  .w-1024.rwd.mx-auto.my-4
    .text-center
      h1 Schulze Method
      p.text-muted electoral system for selecting winners using votes that express preferences. Powered by #[a(href="/") Schulze.js].
      hr
      p.text-muted change values in grid to see how rank changes. You can also copy & paste directly from Google spreadsheet.
    #grid.text-center
      .input.mb-4
        .btn.btn-outline-dark.mr-2(data-action="clear") Reset
        .btn.btn-outline-dark(data-action="sample") Load Sample
      .inner.text-sm.w-100
    #detail-grid.mt-4.text-center.mx-auto
      h3 Detail Versus Result
      p.text-muted Cell[#[code row]][#[code col]] = the number of winning vote for #[code row] against #[code col].
      .inner.text-sm.w-100
      p.text-muted.text-sm.mt-2 click any row above to see why that project sits where it does.
    #explain.mt-4
  .p-4.text-center
    a(href="/") Documentation

block script
  +script({name: "papaparse", path: "index.js"})
  +script({name: "@plotdb/sheet"})
  +script("/assets/lib/schulze.js/dev/index.min.js")
  +script("/js/app/index.js")
